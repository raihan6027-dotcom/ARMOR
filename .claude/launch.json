{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "E:/armor/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "E:/armor/backend",
        "--port",
        "8000"
      ],
      "cwd": "E:/armor/backend",
      "port": 8000
    },
    {
      "name": "generator",
      "runtimeExecutable": "E:/armor/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "armor_generator_mock.service:app",
        "--app-dir",
        "E:/armor/generator_mock",
        "--port",
        "8200"
      ],
      "cwd": "E:/armor/generator_mock",
      "port": 8200
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "E:/armor/app"
      ],
      "port": 3000
    }
  ]
}
