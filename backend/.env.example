# ===== Konfigurasi backend ARMOR =====
# Salin ke `.env` lalu isi nilainya. JANGAN pernah commit `.env`.
# Buat rahasia baru dengan:  python scripts/gen_secrets.py

APP_NAME=ARMOR Main Backend API
APP_VERSION=0.3.0
# dev | production. Di production, CORS_ORIGINS tidak boleh "*".
APP_ENV=dev

# ---- Basis data ----
# Lokal (tanpa server, cocok untuk demo offline):
DATABASE_URL=sqlite:///./armor.db
# Deploy (MySQL atau PostgreSQL):
# DATABASE_URL=mysql+pymysql://armor:ganti-password@localhost:3306/armor
# DATABASE_URL=postgresql+psycopg://armor:ganti-password@localhost:5432/armor

# ---- Autentikasi / JWT ----
# Wajib diganti. Hasilkan dengan scripts/gen_secrets.py (minimal 32 byte acak).
JWT_SECRET=ganti-dengan-hasil-gen-secrets
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Biaya hash kata sandi (minimal 12 di produksi).
BCRYPT_ROUNDS=12

# ---- Enkripsi embedding biometrik (Fernet, 32 byte base64 url-safe) ----
# Wajib diisi sebelum enrollment. Kehilangan kunci = embedding tidak bisa dibaca.
ARMOR_EMBEDDING_KEY=

# ---- CORS (dipisah koma). "*" hanya untuk dev. ----
CORS_ORIGINS=http://localhost:3000

# ---- Model AI lokal (diunduh sebelumnya agar bisa offline) ----
# Kosongkan untuk memakai <repo>/ml/models (bawaan).
MODEL_DIR=
INSIGHTFACE_MODEL=buffalo_l
# Ambang cosine dan margin zona abu-abu. Nilai final WAJIB dari ml/face_eval
# (lihat docs/eval/face.md); nilai di bawah hanya placeholder sementara.
FACE_MATCH_THRESHOLD=0.40
FACE_GRAY_MARGIN=0.05
# Enrollment: kemiripan minimum antar 3 tangkapan (orang yang sama)
FACE_SAME_PERSON_THRESHOLD=0.50
# Cek kualitas wajah
FACE_MIN_SIZE_PX=80
FACE_MIN_BLUR_VAR=60
FACE_MAX_YAW_DEG=45
FACE_MAX_PITCH_DEG=35
# Enrollment: selisih sudut (yaw) minimum antar tangkapan, penangkal foto diam
FACE_MIN_POSE_SPREAD_DEG=8

# ---- Versi teks persetujuan lapis 1 (docs/consent-text/) ----
CONSENT_TEXT_FACE=face-v1
CONSENT_TEXT_VOICE=voice-v1

VOICE_MATCH_THRESHOLD=0.45
VOICE_GRAY_MARGIN=0.05

# ---- Batas unggahan ----
MAX_IMAGE_MB=8
MAX_AUDIO_MB=15
MAX_AUDIO_SECONDS=60
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=30

# ---- Rate limit ----
CONSENT_REQUESTS_PER_DAY=3

# ---- Notifikasi email (opsional; matikan saat demo offline) ----
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ARMOR <no-reply@armor.local>

# ---- Generator setelah ALLOW (Fase 8) ----
# mock (bawaan, offline: generator_mock/) | diffusers (opsional, butuh GPU + bobot model)
# | auto (diffusers jika tersedia, selain itu mock)
GENERATOR=mock
GENERATOR_URL=http://127.0.0.1:8200
GENERATOR_TIMEOUT_S=120
# Kosong = <MODEL_DIR>/generator/sd (folder diffusers berisi model_index.json)
GENERATOR_MODEL_DIR=

# ---- ARMOR Shield ----
# Kunci HMAC manifest; kosong = diturunkan dari JWT_SECRET. Jangan diganti setelah
# ada gambar yang diberi Shield (tanda tangannya tidak akan cocok lagi).
SHIELD_SIGNING_KEY=
SHIELD_PHASH_MAX_DISTANCE=10
PUBLIC_VERIFY_PER_MINUTE=20

# ---- Retensi log keputusan (hari) ----
LOG_RETENTION_DAYS=90
