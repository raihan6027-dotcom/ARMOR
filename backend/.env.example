# ===== ARMOR Backend configuration =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

APP_NAME=ARMOR Main Backend API
APP_VERSION=0.2.0

# ---- Database ----
# Deployment target is MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/armor
# Local dev without a MySQL server (zero setup):
# DATABASE_URL=sqlite:///./armor.db

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS (comma-separated origins, or * for all) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Gemini (intent / risk / analysis) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30

# ---- Face identity model (ArcFace / InsightFace) ----
# Folder holding the pre-deployment artifacts (official_face_registry.pkl, etc.).
MODEL_DIR=C:\Project ARMOR\Pre Deployment\Model Gambar
FACE_REGISTRY_FILE=official_face_registry.pkl
INSIGHTFACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.40
